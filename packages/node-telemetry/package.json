{
  "name": "@ratingo/node-telemetry",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "cd ../.. && eslint packages/node-telemetry/src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint:dead-code": "cd ../.. && knip --workspace packages/node-telemetry"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/sdk-metrics": "2.12.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "jest": "^29.7.0",
    "knip": "6.47.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5"
  }
}
