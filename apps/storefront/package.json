{
  "name": "storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start -p ${PORT:-3003}",
    "lint": "eslint app src && npm run lint:fsd",
    "lint:fsd": "steiger ./src",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint:dead-code": "cd ../.. && knip --workspace apps/storefront",
    "test": "jest"
  },
  "dependencies": {
    "@ratingo/web-core": "*",
    "@tanstack/react-query": "^5.80.6",
    "next": "16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.1",
    "fast-check": "^4.5.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "knip": "6.44.1",
    "steiger": "0.9.0",
    "typescript": "^5"
  }
}
