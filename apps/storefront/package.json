{
  "name": "storefront",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start -p ${PORT:-3003}",
    "lint": "eslint app src && npm run lint:fsd",
    "lint:fsd": "steiger ./src",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint:dead-code": "cd ../.. && knip --workspace apps/storefront",
    "test": "jest",
    "analyze": "next analyze --output"
  },
  "dependencies": {
    "@heroui/react": "3.2.7",
    "@ratingo/ui": "*",
    "@ratingo/web-core": "*",
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.2.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.1",
    "fast-check": "^4.5.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "knip": "6.44.2",
    "steiger": "0.10.0",
    "typescript": "^5"
  }
}
