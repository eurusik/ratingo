# Environment variables for web-client
# Copy this file to .env.local and fill in the values

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public site URL (for meta tags, redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Google Analytics 4 Measurement ID (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Image proxy origin (Cloudflare Worker) — enables TMDB + TVMaze proxying
# NEXT_PUBLIC_IMAGE_PROXY_ORIGIN=https://img.ratingo.top

# Server-side API origin over a private network (optional, falls back to NEXT_PUBLIC_API_URL)
# API_INTERNAL_URL=http://api.railway.internal:8080
