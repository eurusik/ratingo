{
  "name": "@ratingo/ai-happy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:packages": "npm run build --workspace=@ratingo/ai-core --workspace=@ratingo/node-telemetry",
    "prebuild": "npm run build:packages",
    "build": "tsc -p tsconfig.build.json",
    "predev": "npm run build:packages",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "cd ../../.. && eslint apps/ai/happy/src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint:dead-code": "cd ../../.. && knip --workspace apps/ai/happy",
    "review": "npm run build:packages && ts-node --transpile-only src/scripts/review.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-fastify": "^11.2.8",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-undici": "0.33.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@ratingo/ai-core": "*",
    "@ratingo/node-telemetry": "*",
    "fastify": "5.12.8",
    "ioredis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "fast-check": "^4.5.2",
    "jest": "^29.7.0",
    "knip": "6.44.1",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
