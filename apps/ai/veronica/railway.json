{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/ai/veronica/Dockerfile",
    "watchPatterns": [
      "/apps/ai/veronica/**",
      "/packages/ai-core/**",
      "/packages/ai-ops-tools/**",
      "/packages/node-telemetry/**",
      "/package.json",
      "/tsconfig.json",
      "/package-lock.json"
    ]
  },
  "deploy": {
    "preDeployCommand": ["npm run db:migrate --workspace=@ratingo/ai-veronica"],
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
