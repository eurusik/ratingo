{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "apps/ai/veronica/Dockerfile" },
  "deploy": {
    "preDeployCommand": ["npm run db:migrate --workspace=@ratingo/ai-veronica"],
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
