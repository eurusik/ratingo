{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "target": "ES2022",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "types": ["jest", "node"]
  },
  "include": ["src/**/*.ts", "eval/**/*.ts"]
}
