{
  "name": "@ratingo/ai-veronica",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:packages": "npm run build --workspace=@ratingo/ai-core --workspace=@ratingo/ai-ops-tools --workspace=@ratingo/node-telemetry",
    "prebuild": "npm run build:packages",
    "build": "tsc -p tsconfig.build.json",
    "predev": "npm run build:packages",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "chat:export": "npm run build:packages && ts-node --transpile-only src/scripts/export-chat-exchanges.ts",
    "chat:flags": "npm run build:packages && ts-node --transpile-only src/scripts/report-flagged-numbers.ts",
    "digest:preview": "npm run build:packages && ts-node --transpile-only src/scripts/render-digest.ts",
    "lint": "cd ../../.. && eslint apps/ai/veronica/src apps/ai/veronica/eval",
    "eval:chat": "npm run build:packages && ts-node --transpile-only eval/chat/run-eval.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint:dead-code": "cd ../../.. && knip --workspace apps/ai/veronica"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-fastify": "^11.2.11",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/instrumentation-ioredis": "0.73.0",
    "@opentelemetry/instrumentation-undici": "0.35.1",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-metrics": "2.12.1",
    "@opentelemetry/sdk-node": "0.301.2",
    "@ratingo/ai-core": "*",
    "@ratingo/ai-ops-tools": "*",
    "@ratingo/node-telemetry": "*",
    "bullmq": "^5.81.6",
    "cron-parser": "^4.9.0",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "5.12.8",
    "ioredis": "^5.8.2",
    "postgres": "^3.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.11",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "fast-check": "^4.11.0",
    "jest": "^29.7.0",
    "knip": "6.48.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
