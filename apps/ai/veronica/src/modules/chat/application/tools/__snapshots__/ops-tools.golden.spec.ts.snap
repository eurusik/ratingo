{"service":"ratingo-api","level":"error","window":"24h","mode":"grouped","text":"a|b{","recordsRead":5,"groups":[{"countInRecordsRead":4,"level":"error","context":"Worker","firstSeenInRecordsReadKyiv":"2026-11-26 12:25","lastSeenAtKyiv":"2026-11-26 12:25","sample":{"message":"Queue stalled","queue":"stats-queue"}},{"countInRecordsRead":3,"level":"error","context":"TrackedShows","firstSeenInRecordsReadKyiv":"2026-11-26 13:30","lastSeenAtKyiv":"2026-11-26 13:40","sample":{"message":"Failed to sync tracked show 4021: timeout"}},{"countInRecordsRead":1,"level":"error","context":"TmdbClient","firstSeenInRecordsReadKyiv":"2026-11-26 13:53","lastSeenAtKyiv":"2026-11-26 13:53","sample":{"errorName":"HttpError","message":"Request failed Authorization: [REDACTED]","errorMessage":"TMDB API: Request timeout [REDACTED]","stackHead":"HttpError: TMDB API: Request timeout | at TmdbClient.get (tmdb.client.ts:88:11) | at SyncMediaService.syncShow (sync-media.service.ts:156:7)","jobId":"sync-show:3100","queue":"ingestion"}}]}
