{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/api": {
      "entry": [
        "src/main.ts",
        "src/worker.ts",
        "src/scripts/*.ts",
        "src/database/seed*.ts",
        "test/**/*.e2e-spec.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "*.{js,ts}"],
      "jest": {
        "config": ["jest.config.js", "jest.e2e.config.js"]
      },
      "drizzle": {
        "config": ["drizzle.config.{ts,js}"]
      }
    },
    "apps/web-client": {
      "entry": ["src/app/sw.ts"],
      "project": ["src/**/*.{ts,tsx,css}", "*.{js,mjs,ts}"]
    },
    "apps/storefront": {
      "entry": ["steiger.config.mjs"],
      "project": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}", "*.{js,mjs,ts}"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "packages/web-core": {
      "project": ["src/**/*.{ts,tsx}", "*.{cjs,ts}"]
    }
  },
  "ignoreIssues": {
    "apps/api/src/common/constants.ts": ["duplicates"],
    "apps/web-client/src/shared/ui/**": ["exports", "types"],
    "apps/storefront/src/shared/ui/**": ["exports"]
  }
}
